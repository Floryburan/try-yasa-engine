{
  "scope": "框架 HTTP 入口识别，不包含 main/模块初始化等引擎默认入口；这是人工预期，不是现有 checker 实测结果。",
  "cases": {
    "django-function-view": {
      "referenceChecker": "src/checker/taint/python/django-taint-checker.ts",
      "framework": "django",
      "triggerEvidence": [
        "urls.py imports django.urls.path",
        "urlpatterns contains path('users/<int:user_id>/', user_detail)"
      ],
      "entryPoints": [
        "user_detail"
      ],
      "inputSources": [
        "user_detail parameter request",
        "user_detail parameter user_id"
      ],
      "mustNotBeEntryPoints": [
        "render_profile"
      ]
    },
    "tornado-route": {
      "referenceChecker": "src/checker/taint/python/tornado-taint-checker.ts",
      "framework": "tornado",
      "triggerEvidence": [
        "tornado.web.Application registers SearchHandler for /search",
        "SearchHandler defines the HTTP method post"
      ],
      "entryPoints": [
        "SearchHandler.post"
      ],
      "inputSources": [
        "return value of self.get_argument('query')",
        "self.request.body"
      ]
    },
    "httpserver-handler": {
      "referenceChecker": "src/checker/taint/python/httpserver-taint-checker.ts",
      "framework": "http.server",
      "triggerEvidence": [
        "ApiHandler inherits BaseHTTPRequestHandler",
        "HTTPServer is constructed with ApiHandler"
      ],
      "entryPoints": [
        "ApiHandler.do_POST"
      ],
      "inputSources": [
        "ApiHandler.do_POST parameter self",
        "self.headers",
        "return value of self.rfile.read(content_length)",
        "self.path"
      ]
    },
    "java-spring-mvc": {
      "language": "java",
      "framework": "Spring MVC",
      "entryPoints": [
        "SearchController.search"
      ],
      "inputSources": [
        "search 的 @RequestParam(\"cmd\") 参数 command"
      ],
      "sinks": [
        "Runtime.getRuntime().exec(command)"
      ],
      "mustNotBeFrameworkEntryPoints": [
        "examples.local.LocalController.search",
        "SearchController.preview",
        "SearchController.execute"
      ],
      "reason": "解析注解的包归属；同名本地注解不是 Spring 注解。execute 是入口调用的 helper，不是独立 HTTP 入口。",
      "expectedFlow": "HTTP 输入 -> 命令执行 sink（故意保留不安全数据流）"
    },
    "java-servlet": {
      "language": "java",
      "framework": "javax.servlet",
      "entryPoints": [
        "CommandServlet.doPost"
      ],
      "inputSources": [
        "request.getParameter(\"cmd\") 返回值"
      ],
      "sinks": [
        "Runtime.getRuntime().exec(command)"
      ],
      "mustNotBeFrameworkEntryPoints": [
        "LocalHandler.doPost",
        "LocalHandler.getParameter",
        "CommandServlet.execute"
      ],
      "reason": "结合 javax.servlet.http.HttpServlet 继承与 @WebServlet 注册；仅有 doPost 方法名不够。",
      "expectedFlow": "HTTP 输入 -> 命令执行 sink（故意保留不安全数据流）"
    },
    "javascript-express": {
      "language": "javascript",
      "framework": "Express",
      "entryPoints": [
        "commandHandler"
      ],
      "inputSources": [
        "req.query.cmd"
      ],
      "sinks": [
        "child_process.exec(command)"
      ],
      "mustNotBeFrameworkEntryPoints": [
        "localHandler",
        "unusedHandler",
        "execute"
      ],
      "reason": "app 来自 express()，且 app.get 注册了 callback；localRegistry.get 是本地普通方法。",
      "expectedFlow": "HTTP 输入 -> 命令执行 sink（故意保留不安全数据流）"
    },
    "javascript-egg": {
      "language": "javascript",
      "framework": "Egg",
      "entryPoints": [
        "CommandController.run"
      ],
      "inputSources": [
        "this.ctx.query.cmd"
      ],
      "sinks": [
        "child_process.exec(command)"
      ],
      "mustNotBeFrameworkEntryPoints": [
        "LocalController.run"
      ],
      "reason": "跨文件关联 app/router.js 中 controller.command.run 与继承 egg.Controller 的控制器；本地 Controller 不属于 Egg。",
      "expectedFlow": "HTTP 输入 -> 命令执行 sink（故意保留不安全数据流）"
    },
    "go-gin": {
      "language": "go",
      "framework": "Gin",
      "entryPoints": [
        "commandHandler"
      ],
      "inputSources": [
        "c.Query(\"cmd\") 返回值"
      ],
      "sinks": [
        "exec.Command(\"sh\", \"-c\", command).Run()"
      ],
      "mustNotBeFrameworkEntryPoints": [
        "localHandler",
        "unusedHandler",
        "execute"
      ],
      "reason": "router 来自 gin.Default()；LocalRouter.GET 不属于 Gin，且没有调用或注册 callback。",
      "expectedFlow": "HTTP 输入 -> 命令执行 sink（故意保留不安全数据流）"
    },
    "go-net-http": {
      "language": "go",
      "framework": "net/http",
      "entryPoints": [
        "commandHandler"
      ],
      "inputSources": [
        "r.URL.Query().Get(\"cmd\") 返回值"
      ],
      "sinks": [
        "exec.Command(\"sh\", \"-c\", command).Run()"
      ],
      "mustNotBeFrameworkEntryPoints": [
        "localHandler",
        "unusedHandler",
        "execute"
      ],
      "reason": "mux 来自 http.NewServeMux()；LocalMux.HandleFunc 不属于 net/http，且没有调用或注册 callback。",
      "expectedFlow": "HTTP 输入 -> 命令执行 sink（故意保留不安全数据流）"
    }
  }
}
